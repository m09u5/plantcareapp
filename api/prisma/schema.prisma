datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  plants   Plant[]
}

model Plant {
  id          Int      @id @default(autoincrement())
  name        String
  lastWatered DateTime @default(now())
  interval    Int
  imageUrl    String?
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}
