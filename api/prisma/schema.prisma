datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma" //aktualna ścieżka z kodem źródłowym
}

model User {
  id                         Int       @id @default(autoincrement())
  email                      String    @unique
  password                   String
  isVerified                 Boolean   @default(false)
  emailVerifiedAt            DateTime?
  emailVerificationTokenHash String?   @unique
  emailVerificationExpiresAt DateTime?
  plants                     Plant[]
}

model Plant {
  id          Int      @id @default(autoincrement())
  name        String
  lastWatered DateTime @default(now())
  interval    Int
  imageUrl    String?
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}
